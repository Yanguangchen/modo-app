# Clarity Workspace environment
# Copy this file to .env for local API and Vite development.
# Current production API runs as a Vercel function. Set server variables there too.
# Only VITE_ variables are exposed to the browser. Never prefix secrets with VITE_.
# Deployment and recovery notes: docs/production-operations.md

# --- Runtime (local Node.js API on port 3001; Vercel in production) ---
NODE_ENV=development
APP_ENV=local
PORT=3001
# Vercel production origin. Local dev uses the Vite origin below.
PUBLIC_APP_URL=http://localhost:5173
# Public API origin. Production uses the Vercel site; local dev uses this process.
API_PUBLIC_URL=http://localhost:3001
# Comma-separated browser origins. Add the Vercel production and preview origins.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# --- Google Cloud project ---
# Firebase and Firestore project. Gemini is called directly with its AI Studio API key.
# Google Cloud federation below authorizes backend database/admin access, not Gemini calls.
GCP_PROJECT_ID=modo-a61c3
GCP_REGION=asia-southeast1
# Cloud Run runtime service account email. Local ADC is used when this is empty.
GCP_SERVICE_ACCOUNT=

# Vercel -> Google Cloud keyless authentication (server-only).
# Set all four for Vercel production; leave all empty for local/Cloud Run ADC.
# Trust must restrict the Vercel team, project and production environment.
# Never upload service-account keys or copy VERCEL_OIDC_TOKEN into these fields.
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# Vercel production also requires APP_ENV=production, HTTPS origins,
# APP_ENCRYPTION_KEY (or KMS_KEY_NAME) and RETENTION_INVOKER_SERVICE_ACCOUNT.

# --- Tenancy (pilot) ---
# Invited users join this tenant on first sign-in. Other members are invited by an admin (POST /v1/admin/invites).
PILOT_TENANT_ID=pilot
# Comma-separated super-admin emails: always admitted with member, admin, and knowledge_owner roles.
BOOTSTRAP_ADMINS=admin@example.com

# --- Firebase ---
# Same project id as GCP_PROJECT_ID for the pilot.
FIREBASE_PROJECT_ID=modo-a61c3
# Leave empty in production. For safe local development, use a demo project and emulators.
# Example server hosts: 127.0.0.1:9099 (Auth), 127.0.0.1:8080 (Firestore).
# These defaults name the real project: copying this file does NOT isolate local data.
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
# Named Firestore database. GCP_REGION does not relocate an existing database.
FIRESTORE_DATABASE_ID=(default)

# --- Private-data key wrapping (APP_ENCRYPTION_KEY in current production; KMS optional) ---
# Full resource name of the key that wraps private bodies and calendar refresh tokens.
# projects/<project>/locations/asia-southeast1/keyRings/<ring>/cryptoKeys/<key>
KMS_KEY_NAME=
# Alternative to KMS: a random 32-byte base64 key, stored as a sensitive,
# server-only Vercel environment variable. Never prefix it with VITE_.
# Preserve it: changing/deleting it makes saved private data unreadable.
# Rotation requires rewrapping data keys; do not replace it arbitrarily.
# Existing kms=none data keys are wrapped in place on access; private data is preserved.
# New unwrapped keys require non-production mode AND FIRESTORE_EMULATOR_HOST.
# Reading production env:v1 keys locally requires the same protected wrapping key;
# prefer a separate test database/emulator instead of accessing production locally.
APP_ENCRYPTION_KEY=

# --- Google Calendar ---
# Separate from Firebase Google sign-in. First connect uses calendar.readonly.
# Write scope is requested only when the user approves a calendar change.
ALLOW_CALENDAR_WRITES=true
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/v1/integrations/calendar/callback

# --- Google AI Studio (Gemini API) ---
# Create a key at https://aistudio.google.com/apikey
# Local: .env.local. Production: a server-only Vercel variable. Never commit the key
# or use a VITE_ name.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Short transformations. Matches the product budget of 8 seconds.
AI_REQUEST_TIMEOUT_MS=8000
AI_MAX_OUTPUT_TOKENS=4096

# --- Guide AI (Gemini 3 workplace chatbot) ---
# One combined assistant for Working Guide preferences and published organization knowledge.
# The Vercel API fetches enabled context, calls GEMINI_MODEL, and returns an answer plus citations.
GUIDE_AI_ENABLED=true
GUIDE_AI_PROMPT_PATH=backend/prompts/communication-coach.md
# Let a signed-in user opt into grounding answers with their own Working Guide fields.
GUIDE_AI_USE_WORKING_GUIDE=true
# Retrieve published tenant knowledge only; draft/private articles are never searchable by the model.
GUIDE_AI_USE_PUBLISHED_KNOWLEDGE=true
# Organization-specific claims must cite article title, owner, and version.
GUIDE_AI_REQUIRE_CITATIONS=true
# Keep external web search and autonomous actions off. Guide AI drafts and explains only.
GUIDE_AI_WEB_SEARCH=false
GUIDE_AI_ALLOW_ACTIONS=false
# Limit conversational context sent to Gemini and do not persist chat transcripts by default.
GUIDE_AI_MAX_HISTORY_MESSAGES=12
# Server-side budget for one Guide AI answer.
GUIDE_AI_TIMEOUT_MS=15000
GUIDE_AI_PERSIST_CONVERSATIONS=false

# --- Retention (days), applied by Cloud Scheduler ---
RETENTION_PRIVATE_DAYS=30
RETENTION_SHARED_DAYS=30
RETENTION_AUDIT_DAYS=365
# Service account email allowed to call POST /internal/retention.
RETENTION_INVOKER_SERVICE_ACCOUNT=

# --- Pilot locks ---
# The process must refuse to start if either of these is true.
ENABLE_MESSAGE_IMPORT=false
ENABLE_TRANSCRIPTION=false

# --- Web client (public; set these in Vercel and in local .env) ---
# Firebase web config from the Firebase console. These values are public by design.
VITE_API_BASE_URL=http://localhost:3001
VITE_FIREBASE_API_KEY=AIzaSyBwVzHD0fRmizlMtrTebUXUpAHk2i7a32Y
VITE_FIREBASE_AUTH_DOMAIN=modo-a61c3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=modo-a61c3
VITE_FIREBASE_STORAGE_BUCKET=modo-a61c3.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=37213192836
VITE_FIREBASE_APP_ID=1:37213192836:web:f3fa2eb37eb557289a78d1
VITE_FIREBASE_MEASUREMENT_ID=G-Z7E0XKF9W6
# Guide AI calls the API. The Gemini key is GEMINI_API_KEY on the server, never a VITE_ variable.
VITE_GUIDE_AI_LABEL=Gemini 3
VITE_GUIDE_CHAT_PATH=/v1/guide/chat
VITE_GUIDE_CHAT_TIMEOUT_MS=20000
# Local prototype responses. Set false in production so every answer comes from the authenticated API.
VITE_GUIDE_CHAT_DEMO_MODE=false
# Clarify uses Gemini through POST /v1/transformations. Set true to use local rules without the API.
VITE_CLARIFY_DEMO_MODE=false
