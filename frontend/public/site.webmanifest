{
  "id": "/",
  "name": "Clarity Workspace",
  "short_name": "Clarity",
  "description": "Calm structure for workplace requests, plans, focus sessions, and meetings.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/?source=homescreen",
  "scope": "/",
  "display": "standalone",
